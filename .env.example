# ActiveSite — environment template. Copy to .env and fill in. Placeholders only; no secrets here.
SAMPLE_MODE=true

# Data layer: Zetaris (ZETARIS_BASE_URL is the web UI checked by smoke_test.py)
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
ZETARIS_TABLE_LAB_RUNS=lab_runs
ZETARIS_TABLE_EDA=eda_residues
ZETARIS_TABLE_PDB=pdb_entries

# Power layer: NVIDIA Nemotron / Meterless (MODEL_NAME is used by the app, NEMOTRON_MODEL by smoke_test.py)
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/llama-3.3-nemotron-super-49b-v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
MODEL_API_KEY=
METERLESS_ENDPOINT=
METERLESS_API_KEY=

# Local services (docker-compose)
POSTGRES_DSN=postgresql://lab@127.0.0.1:56432/activesite
MINIO_ENDPOINT=http://127.0.0.1:59100
# Set to 1 to skip Postgres/MinIO/RCSB in the DuckDB stand-in (tests, offline judging)
CATALOG_OFFLINE=
